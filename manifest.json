{
  "manifest_version": 3,
  "name": "USvisaSlotChecker",
  "version": "1.0.0",
  "description": "A local browser assistant for monitoring the configured visa appointment page. Human verification remains manual.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://www.usvisascheduling.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "USvisaSlotChecker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    },
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.usvisascheduling.com/*"
      ],
      "js": [
        "src/logic.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
